# ── 凭据：绝对不能提交 ─────────────────────────
# config.json 里是明文的 API Key。它已经被忽略，请不要用 -f 强行加入。
config.json
**/config.json

# ── 本机运行数据 ──────────────────────────────
# star.db 是你自己的星图：结构、讲义、每一条生成记录都在里面。
star.db
*.db
*.db-journal
*.db-wal

# ── 日志与调试 ────────────────────────────────
server.log
server.log.err
_dbg.txt
*.log

# ── 手工备份（工作区没有 git，之前靠 .bak 留底）──
*.bak
*.bak[0-9]
*.bak[0-9][0-9]

# ── 隔离测试目录 ──────────────────────────────
.tmp-*/

# ── 编辑器 / 系统 / 浏览器 ────────────────────
.edge-profile/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 运行时（本项目其实没有依赖，写上以防万一）──
node_modules/
package-lock.json

# ── 推送辅助脚本（开发者本机工具，不属于项目本体）──
push-to-github.js

# 主页发布用的临时工作副本（push-site.ps1）
.deploy/
site/
push-site.js
push-site.ps1

# ── 浏览器自动化测试留下的用户目录 / 预览快照 ──
.edge-run/
preview/
profile/
